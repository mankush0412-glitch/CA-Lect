# --- required ---
BOT_TOKEN=123456:replace_with_token_from_BotFather
OWNER_ID=123456789                 # your numeric Telegram user id (always Super Admin)
PUBLIC_URL=https://your-app.example.com   # https URL of this server (enables webhook mode + Mini App buttons)
STORAGE_CHANNEL_ID=-1001234567890  # private channel; add the bot as ADMIN. Lectures/notes are stored here
# --- optional ---
BRAND_NAME=StudyMate
DATA_DIR=./data                    # SQLite database + backups. MUST be on a persistent disk
PORT=3000
WEBHOOK_SECRET=change_me_random    # recommended in webhook mode
POSTBACK_SECRET=                   # only if your ad network supports server-to-server postback
BOT_MODE=                          # webhook | polling | off (default: webhook if PUBLIC_URL is set, else polling)
DOMAIN=your-app.example.com        # only for docker-compose (Caddy HTTPS); must equal the host part of PUBLIC_URL
# --- optional extras ---
DELIVERY_BOT_TOKEN=                # second bot that delivers lectures/notes
RAZORPAY_KEY_ID=                   # optional paid "save pass"
RAZORPAY_KEY_SECRET=

# --- keep your data when the server/container is replaced (set ONE or BOTH) ---
MONGODB_URI=                       # e.g. mongodb+srv://user:pass@cluster.mongodb.net  → snapshot of the database is kept in MongoDB and restored automatically on a fresh server
MONGODB_DB=studymate               # optional database name
BACKUP_CHAT_ID=                    # private channel/group id where the bot pins database snapshots (defaults to STORAGE_CHANNEL_ID). Bot needs admin + "pin messages"
BACKUP_EVERY_MIN=10                # how often to save when something changed
# FORCE_RESTORE=1                  # set once to overwrite the local database with the newest snapshot
# --- force-join channels from env (added to the ones saved in the admin panel; max 12 each) ---
# Format: Title|https://t.me/xxxx|-100chatid ; Title2|https://t.me/yyyy|-100chatid2   (or a JSON list)
# Only chat ids also work:  JOIN_CHANNELS_FOUNDATION=-1001234567890,-1009876543210  (the bot must be admin/member there; title + join link are fetched automatically)
JOIN_CHANNELS=                     # shown to everyone
JOIN_CHANNELS_FOUNDATION=          # only CA Foundation students
JOIN_CHANNELS_INTERMEDIATE=        # only CA Intermediate students
ADSGRAM_SECRET=                    # optional: verify Adsgram rewards on the server
